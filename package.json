{
  "name": "@lexq/cli",
  "version": "0.1.53",
  "description": "LexQ CLI — manage policies, simulate rules, and deploy from the terminal. Built for humans and AI agents.",
  "type": "module",
  "bin": {
    "lexq": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./mcp": {
      "types": "./dist/mcp/register.d.ts",
      "import": "./dist/mcp/register.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "AGENTS.md",
    "CONTEXT.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "enums": "node scripts/gen-enums.mjs",
    "enums:check": "node scripts/gen-enums.mjs --check",
    "constants:check": "node scripts/check-constants.mjs",
    "surface:check": "node scripts/check-public-surface.mjs",
    "ab-key:check": "node scripts/check-ab-key.mjs",
    "start": "node dist/index.js",
    "test:decimals": "pnpm build && node tests/exact-decimals.mjs",
    "test:fact-key": "node tests/fact-key.mjs",
    "prepublishOnly": "pnpm build",
    "knip": "knip",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "lexq",
    "rule-engine",
    "policy-engine",
    "cli",
    "ai-agent",
    "agent-skills",
    "simulation",
    "business-rules"
  ],
  "author": "LexQ, LLC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lexq-io/lexq-cli.git"
  },
  "homepage": "https://lexq.io",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "dedent": "^1.7.2",
    "lossless-json": "4.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.12.0",
    "eslint": "^10.2.0",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0"
  }
}
